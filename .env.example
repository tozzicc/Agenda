# Obrigatórias para o funcionamento básico
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
JWT_SECRET=gere_um_segredo_longo_e_aleatorio
APP_URL=http://localhost:5173
NODE_ENV=development

# Opcionais: necessárias somente para envio de e-mails por SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario_smtp
SMTP_PASS=senha_smtp
SMTP_SECURE=false

# Obrigatórias somente durante: npm run create-admin
ADMIN_NAME=Nome do Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=defina_uma_senha_segura

# Obrigatórias somente para popular um banco exclusivo de demonstração
DEMO_MODE=false
DEMO_PASSWORD=
